# Для локальной разработки (npm run dev)
VITE_API_URL=http://localhost:8080

# Для Docker (docker-compose) — заполнить в .env
POSTGRES_DB=psportal
POSTGRES_USER=psportal
POSTGRES_PASSWORD=замени_на_пароль

JWT_SECRET=замени_на_случайную_строку_мин_32_символа

# Ключ шифрования переписки в чате (AES, хранится в БД зашифрованной)
MESSAGE_ENCRYPTION_KEY=замени_на_случайную_строку_любой_длины

FRONTEND_URL=https://твой-домен.ru

# ── Вход через соцсети (VK ID, Яндекс OAuth) ──
# Куда вернуть пользователя после входа (страница фронта). Локально: http://localhost:5173
OAUTH_FRONTEND_URL=https://твой-домен.ru
# VK: создать приложение на https://dev.vk.com → «Настройки» (ID приложения и Защищённый ключ)
OAUTH_VK_CLIENT_ID=
OAUTH_VK_CLIENT_SECRET=
OAUTH_VK_REDIRECT_URI=https://твой-домен.ru/api/auth/oauth/vk/callback
# Яндекс: создать приложение на https://oauth.yandex.ru → права «Доступ к email и логину»
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_YANDEX_REDIRECT_URI=https://твой-домен.ru/api/auth/oauth/yandex/callback

# Timeweb S3 — хранение файлов (аватары, материалы, вложения)
# Пока бакет не создан — оставь S3_ENABLED=false, файлы будут писаться на локальный диск
S3_ENABLED=false
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Необязательно: свой публичный домен/CDN перед бакетом. Если пусто — используется ENDPOINT/BUCKET
S3_PUBLIC_URL=

# ── Видеосвязь: медиасервер LiveKit (отдельный сервер, см. deploy/livekit/README.md) ──
# Адрес для браузера (через Caddy с TLS на медиасервере)
LIVEKIT_URL=wss://livekit.твой-домен.ru
# Адрес серверного API; если пусто — берётся LIVEKIT_URL с заменой wss:// на https://
LIVEKIT_API_URL=
# Та же пара ключей, что в LIVEKIT_KEYS на медиасервере
LIVEKIT_API_KEY=замени_на_ключ
LIVEKIT_API_SECRET=замени_на_секрет_мин_32_символа

# Посещаемость: ученик «был на занятии», если пробыл не меньше этой доли длительности, %
ATTENDANCE_THRESHOLD_PERCENT=50
# Списывать ли занятие с ученика, не пришедшего на проведённое занятие (true/false)
BILLING_CHARGE_ABSENT=true

# pgAdmin — только через SSH-туннель (порт 5050 слушает 127.0.0.1)
PGADMIN_EMAIL=admin@твой-домен.ru
PGADMIN_PASSWORD=замени_на_пароль

# Dozzle — просмотр логов контейнеров (порт 8888 слушает 127.0.0.1, доступ через SSH-туннель)
